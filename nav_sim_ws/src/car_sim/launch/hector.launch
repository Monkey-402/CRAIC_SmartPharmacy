<launch>
  <!-- Hector SLAM（仿真）：默认 200×200 @ 0.05m（约 10m 边长）。 -->

  <arg name="map_size" default="200" doc="Hector 栅格边长（像素）；0.05m 下 200≈10m"/>
  <arg name="map_multi_res_levels" default="2"/>

  <node pkg="hector_mapping" type="hector_mapping" name="hector_mapping" output="screen">

    <param name="map_frame" value="map" />
    <param name="odom_frame" value="odom" />
    <param name="base_frame" value="base_footprint" />

    <param name="pub_map_odom_transform" value="true" />
    <param name="tf_pub_rate" value="20.0" />
    <param name="transform_tolerance" value="1.0" />
    <param name="scan_subscriber_queue_size" value="5" />
    <param name="initial_yaw" value="0.0" />

    <param name="map_resolution" value="0.05" />
    <param name="map_size" value="$(arg map_size)" />
    <param name="map_start_x" value="0.5" />
    <param name="map_start_y" value="0.5" />

    <param name="map_update_distance_thresh" value="0.1" />
    <param name="map_update_angle_thresh" value="0.04" />
    <param name="map_pub_period" value="2" />

    <!-- 与实车一致：订 /scan_filtered（sim_sensor_bridge 由上层 launch 提供） -->
    <remap from="scan" to="/scan_filtered" />

    <param name="laser_min_dist" value="0.1" />
    <param name="laser_max_dist" value="10.0" />
    <param name="laser_z_min_value" value="-0.5" />
    <param name="laser_z_max_value" value="0.5" />

    <param name="max_iterations" value="500" />
    <param name="epsilon" value="0.0001" />
    <param name="map_multi_res_levels" value="$(arg map_multi_res_levels)" />

    <param name="output_timing" value="false" />
    <param name="pub_drawings" value="false" />
    <param name="pub_map_scanmatch_transform" value="true" />
  </node>

</launch>
