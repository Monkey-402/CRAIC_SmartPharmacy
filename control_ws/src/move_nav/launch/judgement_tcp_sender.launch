<launch>
  <!-- 单独启动时也会加载 config/judgement.yaml；经 control.launch 拉起时 YAML 已在父 launch 加载 -->
  <arg name="judgement_config" default="$(find move_nav)/config/judgement.yaml" />
  <rosparam file="$(arg judgement_config)" command="load" />

  <node name="judgement_tcp_sender"
        pkg="move_nav"
        type="judgement_tcp_sender.py"
        output="screen" />
</launch>
