<launch>
  <!-- 2 号车：standby 起点 + TCP client；peer 为 1 号车 IP -->
  <!-- 双机仿真（104/105）：roslaunch ... car_tcp_peer_ip:=192.168.1.104 -->
  <arg name="car_tcp_peer_ip" default="192.168.1.104" />
  <include file="$(find move_nav)/launch/control.launch">
    <arg name="car_id" value="2" />
    <arg name="dual_car_mode" value="true" />
    <arg name="enable_car_tcp" value="true" />
    <arg name="car_tcp_peer_ip" value="$(arg car_tcp_peer_ip)" />
  </include>
</launch>
