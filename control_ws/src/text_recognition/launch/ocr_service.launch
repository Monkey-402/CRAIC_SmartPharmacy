<launch>
  <arg name="board2_decode_service" default="/yaofang_vision/board2_decode" />
  <!-- 暗色遮罩：灰度<=阈值置黑，其余置白；框检测与 OCR 共用 -->
  <arg name="dark_mask_threshold" default="120" />
  <!-- 黑框失败时回退的比例 ROI -->
  <arg name="roi_x1_ratio" default="0.08" />
  <arg name="roi_y1_ratio" default="0.18" />
  <arg name="roi_x2_ratio" default="0.92" />
  <arg name="roi_y2_ratio" default="0.88" />
  <!-- A4 黑框检测（长边/短边≈1.414） -->
  <arg name="use_frame_detect" default="true" />
  <arg name="frame_min_area_ratio" default="0.04" />
  <arg name="frame_max_area_ratio" default="0.75" />
  <arg name="frame_aspect_tol" default="0.22" />
  <arg name="frame_min_side" default="50" />
  <arg name="frame_crop_margin_ratio" default="0.04" />
  <arg name="tesseract_psm" default="7" />
  <arg name="use_keyword_inference" default="true" />
  <arg name="save_debug_images" default="true" />

  <node
      pkg="text_recognition"
      type="ocr_service.py"
      name="ocr_service"
      output="screen">
    <param name="board2_decode_service" value="$(arg board2_decode_service)" />
    <param name="dark_mask_threshold" value="$(arg dark_mask_threshold)" />
    <param name="roi_x1_ratio" value="$(arg roi_x1_ratio)" />
    <param name="roi_y1_ratio" value="$(arg roi_y1_ratio)" />
    <param name="roi_x2_ratio" value="$(arg roi_x2_ratio)" />
    <param name="roi_y2_ratio" value="$(arg roi_y2_ratio)" />
    <param name="use_frame_detect" value="$(arg use_frame_detect)" />
    <param name="frame_min_area_ratio" value="$(arg frame_min_area_ratio)" />
    <param name="frame_max_area_ratio" value="$(arg frame_max_area_ratio)" />
    <param name="frame_aspect_tol" value="$(arg frame_aspect_tol)" />
    <param name="frame_min_side" value="$(arg frame_min_side)" />
    <param name="frame_crop_margin_ratio" value="$(arg frame_crop_margin_ratio)" />
    <param name="tesseract_psm" value="$(arg tesseract_psm)" />
    <param name="use_keyword_inference" value="$(arg use_keyword_inference)" />
    <param name="save_debug_images" value="$(arg save_debug_images)" />
  </node>
</launch>
