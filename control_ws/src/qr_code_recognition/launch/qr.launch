<launch>
  <arg name="board1_decode_service" default="/yaofang_vision/board1_decode" />
  <arg name="image_ready_timeout_sec" default="0.5" />
  <arg name="image_ready_poll_sec" default="0.01" />

  <!-- 亮区质心 + 全图 pyzbar（见 qr_decoder.py） -->
  <arg name="bright_thresh" default="165" />
  <arg name="min_bright_pixels" default="30" />
  <arg name="min_qr_area" default="120" />
  <arg name="save_slot_crops" default="true" />
  <arg name="crop_margin_ratio" default="0.15" />

  <node
      pkg="qr_code_recognition"
      type="qr_node.py"
      name="qr_node"
      output="screen">
    <param name="board1_decode_service" value="$(arg board1_decode_service)" />
    <param name="image_ready_timeout_sec" value="$(arg image_ready_timeout_sec)" />
    <param name="image_ready_poll_sec" value="$(arg image_ready_poll_sec)" />
    <param name="bright_thresh" value="$(arg bright_thresh)" />
    <param name="min_bright_pixels" value="$(arg min_bright_pixels)" />
    <param name="min_qr_area" value="$(arg min_qr_area)" />
    <param name="save_slot_crops" value="$(arg save_slot_crops)" />
    <param name="crop_margin_ratio" value="$(arg crop_margin_ratio)" />
  </node>
</launch>
