<launch>
  <!-- 实机导航（AMCL + 静态地图）：map_server + [可选 EKF] + AMCL + move_base。
       依赖外部底盘已发布 TF、/scan_filtered、/odom；EKF 模式还需 /imu_data。
       默认 use_ekf:=true；不用 EKF 见 nav_real_amcl_no_ekf.launch（底盘须 pub_odom_tf:=true）。 -->

  <arg name="use_sim_time" default="false"/>
  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <arg name="map" default="map_sim.yaml" doc="map yaml under car_sim/map"/>
  <arg name="no_rviz" default="false"/>
  <arg name="use_ekf" default="true"/>

  <arg name="odom_topic" default="/odometry/filtered" if="$(arg use_ekf)"/>
  <arg name="odom_topic" default="/odom" unless="$(arg use_ekf)"/>
  <arg name="initial_pose_x" default="0.0"/>
  <arg name="initial_pose_y" default="0.0"/>
  <arg name="initial_pose_a" default="0.0"/>
  <arg name="teb_config" default="$(find car_sim)/param/base_local_planner_params_TEB.yaml"
       doc="TEB yaml：默认 / smooth / conservative_half / official_max_vel"/>

  <include file="$(find car_sim)/launch/map_server.launch">
    <arg name="map" value="$(arg map)"/>
  </include>

  <group if="$(arg use_ekf)">
    <include file="$(find car_sim)/launch/ekf.launch"/>
  </group>

  <include file="$(find car_sim)/launch/amcl.launch">
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="initial_pose_x" value="$(arg initial_pose_x)"/>
    <arg name="initial_pose_y" value="$(arg initial_pose_y)"/>
    <arg name="initial_pose_a" value="$(arg initial_pose_a)"/>
  </include>

  <include file="$(find car_sim)/launch/move_base.launch">
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="teb_config" value="$(arg teb_config)"/>
  </include>

  <group unless="$(arg no_rviz)">
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find car_sim)/rviz/nav.rviz"/>
  </group>
</launch>
