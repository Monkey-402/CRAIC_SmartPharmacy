<launch>
  <!-- 相机话题已与官方 /control_ws 对齐，默认不再转发；仅 legacy 兼容时可设 relay_rgb:=true -->
  <node pkg="topic_remap_ros" type="topic_remap_node.py" name="topic_remap_node" output="screen">
    <param name="relay_rgb" value="false"/>
    <param name="rgb_in" value="/camera/rgb/image_raw"/>
    <param name="rgb_out" value="/camera/image_raw"/>

    <!-- nav 节点已直接订 /scan_filtered + base_laser_link，勿再把滤波结果发回 /scan -->
    <param name="relay_scan" value="false"/>
  </node>
</launch>
